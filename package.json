{
  "name": "dsh-comfyui-studio",
  "version": "0.2.0",
  "description": "ComfyUI studio for DeepSeek Harness: generate images AND short videos (Wan 2.1 text-to-video) on your own GPU or a remote ComfyUI, with a full in-app control panel - server probe, model list, hardware presets, launcher, and every parameter editable from the plugin page.",
  "type": "module",
  "license": "MIT",
  "author": "local",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/config.js",
    "lib/comfy.js",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "comfyui",
    "stable-diffusion",
    "image-generation",
    "local-image-generation",
    "sdxl",
    "video-generation",
    "wan",
    "text-to-video"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
